# ---- Database ----
DATABASE_URL="postgresql://vantage:vantage@localhost:5432/vantage?schema=public"
# Optional: direct (non-pooled) connection used by Prisma Migrate
DIRECT_URL="postgresql://vantage:vantage@localhost:5432/vantage?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Five taps on the wordmark opens a code prompt that signs you straight into
# the admin area. Adopted into the database (hashed) on first use, after which
# it is changed from Admin > Settings and this line is ignored.
ADMIN_UNLOCK_CODE="WcpAdmin2026"
SESSION_MAX_AGE_DAYS="30"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="WebcamPrime"

# ---- Media storage ----
# local | s3
MEDIA_PROVIDER="local"
MEDIA_LOCAL_ROOT="./public/uploads"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000/uploads"
MEDIA_MAX_UPLOAD_MB="512"
# Comma-separated hostnames allowed by next/image
NEXT_PUBLIC_MEDIA_HOSTS=""

# ---- Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, B2) ----
# Required when MEDIA_PROVIDER=s3. NEVER commit real credentials.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Public origin for processed media — point this at the CDN, not the bucket,
# so segments are served by the edge rather than through Next.js.
STORAGE_PUBLIC_URL=""
# Path-style addressing is required by MinIO and some R2 setups.
STORAGE_FORCE_PATH_STYLE="false"

# Image upload ceiling is fixed at 12MB in code (lib/media/image-validation).
# Only video needs a configurable limit.

# ---- Video pipeline ----
MAX_VIDEO_UPLOAD_MB="2048"
# Absolute or relative path for in-flight uploads and FFmpeg scratch space.
VIDEO_WORK_DIR="./.tmp/video"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
# Worker tuning
WORKER_POLL_INTERVAL_MS="5000"
WORKER_CONCURRENCY="1"

# ---- Email ----
# console | resend | postmark | smtp
# "console" writes messages to the server log and delivers nothing. Any other
# provider requires EMAIL_FROM. Never commit a real API key.
EMAIL_PROVIDER="console"
EMAIL_FROM=""
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
POSTMARK_MESSAGE_STREAM="outbound"

# ---- Rate limiting ----
# memory | redis  (redis store is a stub until a client is wired up)
RATE_LIMIT_STORE="memory"
REDIS_URL=""

# ---- Development seed (local only) ----
# These are the credentials the seed writes for the first administrator.
# Leaving the password blank makes the seed invent a random one and print it
# to the terminal exactly once, which is easy to miss — so a usable default is
# set here instead. Change it before the site is reachable by anyone else, and
# never set these in production: the seed is a development tool and must not
# run against a live database.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@2026"
